#!/usr/bin/env python
# Сборка расчётного ядра и моста GDExtension.
# Целевой API Godot зафиксирован в docs/decisions.md.

env = SConscript("thirdparty/godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["include/", "godot_bridge/"])
sources = Glob("src/core/*.cpp") + Glob("godot_bridge/*.cpp")

bin_dir = "../game/bin"
name = "libmesim"

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "{0}/{1}.{2}.{3}.framework/{1}.{2}.{3}".format(bin_dir, name, env["platform"], env["target"]),
        source=sources,
    )
elif env["platform"] == "ios":
    suffix = ".simulator" if env["ios_simulator"] else ""
    library = env.StaticLibrary(
        "{0}/{1}.{2}.{3}{4}.a".format(bin_dir, name, env["platform"], env["target"], suffix),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "{0}/{1}{2}{3}".format(bin_dir, name, env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

env.NoCache(library)
Default(library)
