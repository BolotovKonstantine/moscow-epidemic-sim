{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Паспорт городского пакета Moscow Epidemic Sim версии 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "package_version", "kind", "description", "created_at", "builder", "region", "sources", "assets"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "package_id": {"$ref": "#/$defs/id"},
    "package_version": {"$ref": "#/$defs/text"},
    "kind": {"enum": ["fixture", "city_data"]},
    "description": {"$ref": "#/$defs/text"},
    "created_at": {"type": "string", "format": "date-time"},
    "builder": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "buffer_meters", "storage_crs", "metric_crs", "boundary_asset_id"],
      "properties": {
        "rule": {"const": "moscow_admin_union_mkad_outer_buffer"},
        "buffer_meters": {"const": 30000},
        "storage_crs": {"const": "EPSG:4326"},
        "metric_crs": {"$ref": "#/$defs/text"},
        "boundary_asset_id": {"$ref": "#/$defs/id"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_type", "url", "owner", "license", "data_date", "acquired_at", "coverage", "format", "sha256", "processing_version"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "source_type": {"enum": ["external", "synthetic"]},
        "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
        "owner": {"$ref": "#/$defs/text"},
        "license": {"$ref": "#/$defs/text"},
        "data_date": {"type": ["string", "null"], "format": "date"},
        "acquired_at": {"type": "string", "format": "date-time"},
        "coverage": {"$ref": "#/$defs/text"},
        "format": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "processing_version": {"$ref": "#/$defs/text"}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "role", "path", "format", "size_bytes", "sha256", "source_ids", "data_kind"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["boundary", "buildings", "roads", "transport", "facilities", "population", "quality_report"]},
        "path": {"$ref": "#/$defs/text"},
        "format": {"$ref": "#/$defs/text"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "data_kind": {"enum": ["observed", "estimated", "game_setting"]},
        "estimation": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "uncertainty"],
          "properties": {"method": {"$ref": "#/$defs/text"}, "uncertainty": {"$ref": "#/$defs/text"}}
        }
      },
      "allOf": [{
        "if": {"properties": {"data_kind": {"const": "estimated"}}, "required": ["data_kind"]},
        "then": {"required": ["estimation"]},
        "else": {"not": {"required": ["estimation"]}}
      }]
    }
  }
}
